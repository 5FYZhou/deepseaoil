%% 图3｜状态机语义｜回答：SwitchState 之后，同一帧还能读到新状态吗？
%% 读法：上下两个子图 = 相邻两帧，不是并列分支；灰色注解不是流程节点。
%% 维护：每帧上限 3 必须与 maxTransitionsPerFrame 的默认值一致。
flowchart TD
  subgraph FN["帧 N"]
    direction TB
    Old["State.OnUpdate()"]
    Req["StateMachine.SwitchState&lt;T&gt;()"]
    Mark["标记 nextState = T"]
    Run["本帧继续按原状态跑完"]
    EndN["帧 N 结束"]
    Old --> Req
    Req --> Mark
    Mark --> Run
    Run --> EndN
  end

  subgraph FN1["帧 N+1"]
    direction TB
    Trans["PerformTransition()"]
    Exit["Old.Exit()"]
    Enter["New.Enter()"]
    NewUpd["New.OnUpdate()"]
    Guard["同帧转移计数 +1"]
    Cap["每帧上限 3"]
    Warn["LogWarning 一次"]
    Trans --> Exit
    Exit --> Enter
    Enter --> NewUpd
    NewUpd --> Guard
    Guard -->|"超限"| Cap
    Cap -.->|"不静默"| Warn
  end

  Mark -->|"下一帧才生效"| Trans
  Global["CheckGlobalTransitions()<br/>Actors.Tick 帧首执行"] -.->|"受击 / 死亡抢占"| Trans
  Same["同一帧内 CurrentState 仍是旧状态"] -.-> Run
  Miss["转移目标不在状态池<br/>静默忽略"]
  Warn -.->|"同时忽略本次转移"| Miss

  classDef frame fill:#e0f2fe,stroke:#0369a1,color:#082f49
  classDef warn fill:#fee2e2,stroke:#dc2626,color:#7f1d1d
  classDef note fill:#f8fafc,stroke:#94a3b8,color:#334155,stroke-dasharray:4 3

  class Old,Req,Mark,Run,EndN,Trans,Exit,Enter,NewUpd,Guard,Cap frame
  class Warn,Miss warn
  class Same,Global note
