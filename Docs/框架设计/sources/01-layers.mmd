%% 图1｜分层与通道｜回答：谁能引谁？跨层唯一通道是什么？哪些直连是允许的？
%% 读法：箭头 = 依赖方向（不是调用方向）。
%%       绿色虚线 = 已知的越界反例。
%%       组合根（GameRoot / PlayerController）允许直连逻辑层，这是第 3 条允许的直连，不是漏洞。
%% 维护：节点名必须与代码标识符一致；本条与蓝图「图 1」代码块保持逐字符一致（由 EditMode 测试守护）。
%%       节点的层归属按**命名空间**判定，不按目录：GameRoot 在 DeepseaOil.Presentation，所以画在表现层。
flowchart LR
  subgraph L1["① Data 数据层　DeepseaOil.Data"]
    direction LR
    ConfigModule["ConfigModule<br/>同步查询　全量常驻"]
    AssetModule["AssetModule<br/>异步 + 引用计数 + 冷却期"]
    SO["PlayerConfig : CharacterConfig<br/>只读 SO　逻辑层直读"]
  end

  subgraph L2["② Logic 逻辑层　DeepseaOil.Logic.*"]
    direction LR
    Logic["ActorLogic / PlayerLogic<br/>速度账本　重力　跳跃余额"]
    States["MoveGroup + StateMachine&lt;MovementStateTag&gt;<br/>7 个状态"]
    Services["PauseService / SceneService / SaveService<br/>IService（GameRoot 每帧驱动）"]
    Pool["Pool&lt;T&gt;　实例级<br/>（当前无调用点）"]
  end

  subgraph L3["③ Presentation 表现层　DeepseaOil.Presentation.*"]
    direction LR
    Root["GameRoot　组合根<br/>Awake 装配　Update 驱动"]
    Player["PlayerController + MovementMotor<br/>FixedUpdate 驱动　实现 IMovementMotor"]
    Input["InputProvider + InputSys<br/>唯一采样点（新输入系统）"]
    Buffer["InputBuffer<br/>窗口缓冲 + 按键沿"]
    UI["UIMgr / BasePanel<br/>MonoMgr　UI 层（资源走 Data 层 AssetModule）"]
    Debug["MovementDebugPanel<br/>EventBusDebugPanel　只读"]
  end

  Bus(["EventBus&lt;T&gt;　T : struct<br/>唯一跨层通道"])
  Violate["越界<br/>非组合根的表现层直接调逻辑层"]
  Ports["端口反转（允许）<br/>表现层实现逻辑层定义的接口：<br/>MovementMotor : IMovementMotor<br/>GameTime : IGameTime"]
  Note1["程序集：全部落默认程序集 Assembly-CSharp（Assets/Scripts 下无 asmdef）<br/>生成物三处，禁止手写：Assets/Scripts/Config/、Assets/StreamingAssets/Luban/<br/>Assets/Scripts/Framework/Input/InputSys.cs（由 .inputactions 生成）"]

  ConfigModule -->|"数值"| Logic
  SO -->|"角色参数"| Logic
  ConfigModule -->|"直连查询"| UI
  AssetModule -->|"资源句柄"| UI

  Root -->|"组合根直连：按序驱动"| Logic
  Player -->|"组合根直连：FixedTick / Move"| Logic
  Player -.->|"允许"| Ports

  UI -->|"意图 RequestPause / RequestResume"| Bus
  Bus -->|"意图"| Services
  Services -->|"事实 GamePaused / GameResumed"| Bus
  Bus -->|"事实"| Player
  States -->|"事实 MovementStateChanged"| Bus
  Bus -->|"事实"| Debug

  UI -.->|"违规"| Violate

  classDef data fill:#ede9fe,stroke:#7c3aed,color:#3b0764
  classDef logic fill:#e0f2fe,stroke:#0369a1,color:#082f49
  classDef pres fill:#dcfce7,stroke:#16a34a,color:#052e16
  classDef root fill:#fef9c3,stroke:#ca8a04,color:#422006
  classDef core fill:#fce7f3,stroke:#db2777,color:#500724
  classDef warn fill:#fee2e2,stroke:#dc2626,color:#7f1d1d
  classDef note fill:#f8fafc,stroke:#94a3b8,color:#334155,stroke-dasharray:4 3

  class ConfigModule,AssetModule,SO data
  class Logic,States,Services,Pool logic
  class Player,Input,Buffer,UI,Debug pres
  class Root root
  class Bus core
  class Violate warn
  class Ports,Note1 note

  %% 越界边 UI->Violate 是第 14 条边（下标 13，共 14 条边）；改动连线顺序时必须同步这个下标
  linkStyle 13 stroke:#dc2626,stroke-width:2px
